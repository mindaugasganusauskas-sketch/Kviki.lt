# Duomenų bazė (docker-compose sukonfigūruoja pati, keisti tik slaptažodį)
DATABASE_URL=postgres://kviki:kviki@localhost:5432/kviki

# Viešas svetainės adresas (naudojamas laiškuose ir nuorodose)
APP_URL=http://localhost:3000

# Kur saugoti įkeltas nuotraukas
UPLOAD_DIR=./uploads

# Demonstraciniai duomenys ir mygtukas „Išbandyti demonstraciją“ (true/false)
DEMO_ENABLED=true

# El. laiškai (nebūtina). Be šių nustatymų pranešimai rodomi tik svetainėje.
# Hostinger pašto pavyzdys: smtp.hostinger.com, 465, secure=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kviki <info@kviki.lt>"
