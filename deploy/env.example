# Nukopijuokite į .env (projekto šaknyje serveryje) ir užpildykite.

# Domenas be https:// – jo DNS A įrašas turi rodyti į serverio IP adresą.
DOMAIN=kviki.lt

# Ilgas atsitiktinis duomenų bazės slaptažodis (pvz.: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Mygtukas „Išbandyti“ ir demonstraciniai duomenys (true/false).
# Paleidus tikrą veiklą rekomenduojama false.
DEMO_ENABLED=true

# El. laiškai apie naujus pasiūlymus ir užsakymus (nebūtina).
# Hostinger pašto dėžutės pavyzdys:
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kviki <info@kviki.lt>"
